# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL=

# Razorpay Configuration (Server-Side)
# Public Key ID (exposed to client)
RAZORPAY_KEY_ID=
# Secret Key (server-side secret only)
RAZORPAY_KEY_SECRET=

# PayPal Configuration (Server-Side)
# Public Client ID (exposed to client)
PAYPAL_CLIENT_ID=
# Client Secret (server-side secret only)
PAYPAL_CLIENT_SECRET=
# PayPal REST API Base URL
# Sandbox: https://api-m.sandbox.paypal.com
# Live: https://api-m.paypal.com
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
